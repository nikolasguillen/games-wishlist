#!/bin/sh
# Enforces the commit message convention documented in CLAUDE.md ("Git" section).
# Enable once per clone:  git config core.hooksPath .githooks

TYPES='feat|fix|refactor|perf|docs|test|style|build|chore'
SCOPES='search|radar|game-detail|lists|wishlist|settings|onboarding|common|model|network|database|data|domain|ui|designsystem|navigation|ai|app|deps|docs'
MAX_LEN=72

# First line that is not a comment (git strips '#' lines from the final message).
subject=$(sed '/^#/d' "$1" | sed -n '1p')

# Messages generated by git itself are not ours to police.
case "$subject" in
  "Merge "*|"Revert "*|"fixup! "*|"squash! "*|"amend! "*) exit 0 ;;
esac

fail() {
  {
    echo "commit-msg: $1"
    echo
    echo "  Subject: $subject"
    echo
    echo "  Expected:  type(scope): subject"
    echo "  Types:     $(echo "$TYPES" | tr '|' ' ')"
    echo "  Scopes:    $(echo "$SCOPES" | tr '|' ' ')  (optional; omit for multi-module changes)"
    echo "  Subject:   imperative, lowercase first letter, no trailing period, <= $MAX_LEN chars in total"
    echo "  Breaking:  type(scope)!: subject"
    echo "  Spec Kit:  [Spec Kit] Any subject"
  } >&2
  exit 1
}

[ -n "$subject" ] || fail "empty commit message."

length=$(printf '%s' "$subject" | awk '{ print length($0) }')
[ "$length" -le "$MAX_LEN" ] || fail "first line is $length characters, the limit is $MAX_LEN."

case "$subject" in
  *.) fail "the subject must not end with a period." ;;
esac

# Spec Kit commits keep their own prefix and free-form subject.
if printf '%s\n' "$subject" | grep -Eq '^\[Spec Kit\] .+'; then
  exit 0
fi

printf '%s\n' "$subject" | grep -Eq "^($TYPES)(\(($SCOPES)\))?!?: .+" \
  || fail "expected 'type(scope): subject' with a known type and, if present, a known scope."

printf '%s\n' "$subject" | grep -Eq "^($TYPES)(\(($SCOPES)\))?!?: [a-z0-9\`]" \
  || fail "the subject must start with a lowercase letter."

# A body, if any, must be separated from the subject by a blank line.
second=$(sed '/^#/d' "$1" | sed -n '2p')
[ -z "$second" ] || fail "leave a blank line between the subject and the body."

exit 0
